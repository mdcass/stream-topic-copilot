{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/stream-topic-copilot/codex-analysis-response-schema.json",
  "title": "CodexAnalysisResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "chunkId",
    "topicDecisions",
    "suggestions",
    "offTopicObservations",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "codexAnalysis.v1"
    },
    "chunkId": {
      "type": "string"
    },
    "topicDecisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/topicDecision"
      }
    },
    "suggestions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activeTopics",
        "elaborationStarters",
        "adjacentNextTopics",
        "recoveryPrompts"
      ],
      "properties": {
        "activeTopics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/suggestion"
          }
        },
        "elaborationStarters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/suggestion"
          }
        },
        "adjacentNextTopics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/suggestion"
          }
        },
        "recoveryPrompts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/suggestion"
          }
        }
      }
    },
    "offTopicObservations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/offTopicObservation"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chunkId",
        "excerpt"
      ],
      "properties": {
        "chunkId": {
          "type": "string"
        },
        "excerpt": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "topicState": {
      "type": "string",
      "enum": [
        "pending",
        "partial",
        "covered",
        "snoozed",
        "dismissed"
      ]
    },
    "topicDecision": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "topicId",
        "suggestedState",
        "confidence",
        "rationale",
        "evidence"
      ],
      "properties": {
        "topicId": {
          "type": "string"
        },
        "suggestedState": {
          "$ref": "#/$defs/topicState"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "suggestion": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "text",
        "confidence",
        "rationale",
        "evidence"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "topicId": {
          "type": "string"
        }
      }
    },
    "offTopicObservation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "label",
        "confidence",
        "rationale",
        "evidence"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "topicId": {
          "type": "string"
        }
      }
    }
  }
}
