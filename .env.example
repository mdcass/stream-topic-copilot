PORT=4312
HOST=127.0.0.1
DATA_DIR=./data
SESSIONS_DIR=./sessions
PUBLIC_DIR=./dist/ui
CONFIG_PATH=./data/config.json
ANALYSIS_PROVIDER=mock
STT_PROVIDER=mock
ANALYSIS_PROVIDER_COMMAND=codex exec --skip-git-repo-check --color never
ANALYSIS_STRUCTURED_OUTPUT_FLAG=--output-schema
ANALYSIS_CONFIDENCE_THRESHOLD=0.8
STT_EXECUTABLE=
WHISPER_MODEL=
POLLING_INTERVAL_MS=2000
LOGGING_FLAGS=analysis,transcript,state
TRANSCRIPT_TAIL_SIZE=30
CHUNK_WORD_THRESHOLD=120
CHUNK_TIME_THRESHOLD_SECONDS=60
CHUNK_SENSITIVITY=medium
VISIBLE_SUGGESTION_COUNT=3
MIC_PERMISSION_HELPER=./.bin/request-microphone-permission
MIC_PROBE_HELPER=./.bin/mic-level-probe
NATIVE_SYSTEM_AUDIO_HELPER=./.bin/native-system-audio-helper
